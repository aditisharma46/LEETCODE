class Solution {
public:
    bool isPalindrome(int x) {
        if (x < 0){
            return false;
        }
        long long count = 0;
        int original = x;

        while(x > 0){

            int digit = x%10;
            count = (count*10)+digit;
            x = x/10;
        }
        return original == count;
        
    }
};
